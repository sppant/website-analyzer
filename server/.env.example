# Google PageSpeed Insights API key (server-side only)
PAGESPEED_API_KEY=

# PostgreSQL connection string.
# Matches the local docker-compose service in the repo root.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/website_analyzer

# Secret used to sign the session cookie. Use a long random value in production,
# e.g. `openssl rand -base64 32`. Minimum 16 characters.
SESSION_SECRET=

# Public base URL of the frontend. Used to build links in emails
# (e.g. the password reset link). Optional — defaults to the Vite dev server
# in development and https://seo.webxdevelop.com in production.
APP_URL=http://localhost:5173

# SMTP — used to send the password-reset email.
# REQUIRED in production: the server refuses to start without it there (it will
# not silently fall back to the console mailer). In development, leave blank to
# use the console mailer, which prints the reset link to the local terminal.
# Set SMTP_HOST/PORT/USER/PASSWORD together, or none of them.
#   SMTP_SECURE — "true" for implicit TLS (port 465). Defaults to true on 465.
#   SMTP_FROM   — envelope From address. Defaults to SMTP_USER.
# Never commit real credentials — put them in a local .env (gitignored) or your
# host's environment configuration.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seo@example.com
SMTP_PASSWORD=
SMTP_FROM=seo@example.com

# Stripe billing. Leave all three blank to disable billing (every user is Free).
# Set all three together (from the Stripe Dashboard, test mode for local dev):
#   STRIPE_SECRET_KEY     — your test-mode secret key, "sk_test_..."
#   STRIPE_WEBHOOK_SECRET — from `stripe listen` or the webhook endpoint settings, "whsec_..."
#   STRIPE_PRICE_PRO      — the id of a recurring $9/month USD Price on your Pro Product, "price_..."
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
